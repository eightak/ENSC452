void Btn_InterruptHandler(void *InstancePtr)
{
	button_pressed_flag = 0;
	//Disable GPIO interrupts
	XGpio_InterruptDisable(&BTNInst, BTN_INT);
	XGpio_InterruptDisable(&BTNInst, SW_INT);
	// Ignore additional button presses
	if (((XGpio_InterruptGetStatus(&BTNInst) & BTN_INT) != BTN_INT) && btn_value == XGpio_DiscreteRead(&BTNInst, 1)) {
		button_pressed_flag = 1;
	}

	int btn_read = XGpio_DiscreteRead(&BTNInst, 1);

	usleep(10000);

	int btn_read_after_delay = XGpio_DiscreteRead(&BTNInst, 1);

	if ((btn_read == btn_read_after_delay) && (btn_read != 0)) {
		btn_value = btn_read;
		button_pressed_flag = 1;
		//xil_printf("button pressed\n");
	}

	sw_value = XGpio_DiscreteRead(&BTNInst, 2);

	if ((prev_sw_value == 0) && (sw_value > 0)) { //rising edge
		switch_rising_edge = 1;
		//xil_printf("switch rising edge\n");
	}

	if ((prev_sw_value > 0) && (sw_value == 0)) { //falling edge
		switch_falling_edge = 1;
		//xil_printf("switch falling edge\n");
	}

	prev_sw_value = sw_value;

	//xil_printf("Button Value = %d\n", btn_value);
	//xil_printf("Switch Value = %d\n", sw_value);
	//XGpio_DiscreteWrite(&LEDInst, 1, led_data);

	(void)XGpio_InterruptClear(&BTNInst, BTN_INT);
	(void)XGpio_InterruptClear(&BTNInst, SW_INT);

	// Enable GPIO interrupts
	XGpio_InterruptEnable(&BTNInst, BTN_INT);
	XGpio_InterruptEnable(&BTNInst, SW_INT);

}

