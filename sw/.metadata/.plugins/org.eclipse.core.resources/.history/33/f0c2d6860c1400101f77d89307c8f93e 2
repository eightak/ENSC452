void weatherIcon(int startx, int starty, int *base_mask, int *image_mask) {

	int iconSize = 100;
	int font_size = 2;
	int weatherw = 800;

	memcpy(image_mask, base_mask, NUM_BYTES_BUFFER);

	int start = startx+(weatherw*starty);
	int writeFrom = 50 + (windoww*150);

	for (int y = 0; y < iconSize * font_size; y++) {
		for (int x = 0; x < iconSize * font_size; x++) {
			if (weather_pointer[start + (x / font_size) + (weatherw * (y / font_size))] < 200) {
				image_mask[writeFrom + x + (windoww * y)] = font_colour;
			}
		}
	}
}

