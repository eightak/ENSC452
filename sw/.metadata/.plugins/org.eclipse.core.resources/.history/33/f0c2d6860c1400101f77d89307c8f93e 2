//int maxh = 64;
const int maxw = 128;
const int height = 7;
const int width = 5;
const int gap = 2;
const int windoww = 1280;

void write_char(int ascii, int startx, int starty, int *image_mask, int font_size){

	int start = maxw + 1 + ((ascii-32) % 18)*(width+gap) + (maxw * (height+gap) * ((ascii-32) / 18));
	int writeFrom = startx+(windoww*starty);

	for (int y = 0; y < height * font_size; y++) {
		for (int x = 0; x < width * font_size; x++) {
			if (font_pointer[start + (x / font_size) + (maxw * (y / font_size))] == 255) {
				image_mask[writeFrom + x + (windoww * y)] = font_colour;
			}
		}
	}

}

void write_string(char *c, int startx, int starty, int *base_mask, int *image_mask, int font_size){

	memcpy(image_mask, base_mask, NUM_BYTES_BUFFER);

	int i = 0;
	while(c[i] != '\0'){
		write_char(c[i], startx + (i*((width*font_size) + gap)), starty, image_mask, font_size);
		i++;
	}
}

