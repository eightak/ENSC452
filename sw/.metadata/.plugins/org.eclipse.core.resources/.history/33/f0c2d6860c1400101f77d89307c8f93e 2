//takes 3 sample points and chooses black font or white font
void chooseFontColour(int startx, int starty, int *base_mask) {

	int writeFrom = startx + (windoww * starty);

	uint32_t sample1 = base_mask[writeFrom];
	uint32_t sample2 = base_mask[writeFrom + 100 + (windoww * 100)];
	uint32_t sample3 = base_mask[writeFrom + 200 + (windoww * 200)];

	uint8_t r1 = sample1 & 0xFF;
	uint8_t g1 = (sample1 >> 8) & 0xFF;
	uint8_t b1 = (sample1 >> 16) & 0xFF;

	uint8_t r2 = sample2 & 0xFF;
	uint8_t g2 = (sample2 >> 8) & 0xFF;
	uint8_t b2 = (sample2 >> 16) & 0xFF;

	uint8_t r3 = sample3 & 0xFF;
	uint8_t g3 = (sample3 >> 8) & 0xFF;
	uint8_t b3 = (sample3 >> 16) & 0xFF;

	float lum1 = 0.2126 * ((float)r1 / 255) + 0.7152 * ((float)g1 / 255) + 0.0722 * ((float)b1 / 255);
	float lum2 = 0.2126 * ((float)r2 / 255) + 0.7152 * ((float)g2 / 255) + 0.0722 * ((float)b2 / 255);
	float lum3 = 0.2126 * ((float)r3 / 255) + 0.7152 * ((float)g3 / 255) + 0.0722 * ((float)b3 / 255);

	if (((lum1 > 0.5) + (lum2 > 0.5) + (lum3 > 0.5)) >= 1) {
		//xil_printf("dark gray\n");
		font_colour = 0xFF1E1E1E;
	}
	else {
		//xil_printf("light gray\n");
		font_colour = 0xFFD3D3D3;
	}
}

void getMusicModeStr(char * charValue, int value){
	switch(value){
	case 1:
		strcpy(charValue, "Repeat Once");
		break;
	case 2:
		strcpy(charValue, "Repeat");
		break;
	default:
		strcpy(charValue, "");
		break;
	}
}
