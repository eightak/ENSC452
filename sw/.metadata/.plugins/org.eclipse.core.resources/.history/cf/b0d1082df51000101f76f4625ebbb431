#include "music.h"

#include <stdio.h>
#include <string.h>
#include "xparameters.h"
#include "random_num_gen_ip.h"
#include "xil_io.h"
#include "shared_mem.h"
#include "interrupts.h" //button values

void music() {
	if (button_pressed_flag) {
		switch(btn_value) {
		case (CENTRE_BUTTON):
			int music_mode = getMusicMode_sharedMemory();

			if (music_mode < NUM_MUSIC_MODE){
				music_mode++;
			}
			else{
				music_mode = 0;
			}
			setMusicMode_sharedMemory(music_mode);
			xil_printf("music_mode = %d\n", music_mode);
			break;
		case (UP_BUTTON):
			setVolumeControlFlag_sharedMemory(1);
			break;
		case (DOWN_BUTTON):
			setVolumeControlFlag_sharedMemory(2);
			break;
		}
	}
}
void getMusicModeStr(char * charValue, int value){
	switch(value){
	case 1:
		strcpy(charValue, "Repeat Once");
		break;
	case 2:
		strcpy(charValue, "Repeat");
		break;
	default:
		strcpy(charValue, "");
		break;
	}
}
